# Motion Index — Environment Variables
# Copy to .env for local Netlify dev (`netlify dev`) or configure in Netlify Site Settings -> Environment variables.

# Required in production: random 32+ byte secret used for HMAC-SHA256 API key signing
MOTION_INDEX_SIGNING_SECRET=change-me-to-a-long-random-secret

# Public site origin (used for checkout redirects, preview links, and MCP docs)
MOTION_INDEX_BASE_URL=https://ai-motion-database.netlify.app

# Stripe credentials (optional — if omitted, billing endpoints run in Sandbox mode and issue mi_test_ keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for each plan & credit pack
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
STRIPE_PRICE_CREDITS_500=price_credits_500
STRIPE_PRICE_CREDITS_2000=price_credits_2000
STRIPE_PRICE_CREDITS_7500=price_credits_7500
STRIPE_PRICE_TEAMS_MONTHLY=price_teams_monthly
STRIPE_PRICE_TEAMS_ANNUAL=price_teams_annual

# MCP Server (for client environments such as Claude Code, Cursor, Codex)
MOTION_INDEX_API_KEY=mi_test_...
MOTION_INDEX_API_URL=https://ai-motion-database.netlify.app
